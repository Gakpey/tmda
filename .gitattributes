# Normalise to LF in the repo - tmda writes LF and a mixed-EOL tree would
# make progress-block diffs noisy on Windows contributors.
* text=auto eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary

# Make GitHub render .tmda as Markdown instead of raw source
*.tmda linguist-language=Markdown
